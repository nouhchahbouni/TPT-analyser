{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "mount": "/"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt",
      "mount": "/api"
    }
  }
}
