{
  "manifest_version": 3,
  "name": "TPT Analyzer",
  "version": "1.0.0",
  "description": "Discover what's selling on TPT right now",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.teacherspayteachers.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TPT Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://www.teacherspayteachers.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "background": {
    "service_worker": "background.js"
  }
}
